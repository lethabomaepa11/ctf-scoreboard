# The URL to your running Supabase instance
NEXT_PUBLIC_SUPABASE_URL=

# The Publishable key for your running Supabase instance
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key (server-side only, needed for admin operations like creating users)
# Get this from your Supabase dashboard: Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=
